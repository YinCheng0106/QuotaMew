    "Average and highest day use reported dates only, including reported zero. The average is rounded to whole tokens. Complete date coverage does not mean values are final." : {
      "extractionState": "manual",
      "comment": "Activity Insights: provider-reported daily buckets only; no billing, quota, or productivity meaning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average and highest day use reported dates only, including reported zero. The average is rounded to whole tokens. Complete date coverage does not mean values are final."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平均與最高日僅以已回報日期計算，包含明確回報的零值。平均取最接近的整數 token。日期涵蓋完整不代表數值已確定。"
          }
        }
      }
    },
    "activity.insights.average %@ %lld" : {
      "extractionState": "manual",
      "comment": "Activity Insights: provider-reported daily buckets only; no billing, quota, or productivity meaning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@ provider-reported tokens per reported date (reported dates: %lld)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個已回報日期約 %@ token（已回報 %lld 個日期）。"
          }
        }
      }
    },
    "activity.insights.highest %@ %@" : {
      "extractionState": "manual",
      "comment": "Activity Insights: provider-reported daily buckets only; no billing, quota, or productivity meaning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ provider-reported tokens."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：供應商回報 %@ token。"
          }
        }
      }
    },
    "activity.insights.tied %lld" : {
      "extractionState": "manual",
      "comment": "Activity Insights: provider-reported daily buckets only; no billing, quota, or productivity meaning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld reported dates share the highest value; the latest source date is shown."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個已回報日期並列最高，顯示最新的來源日期。"
          }
        }
      }
    },
    "activity.insights.previous-dates %@ %@" : {
      "extractionState": "manual",
      "comment": "Activity Insights: provider-reported daily buckets only; no billing, quota, or productivity meaning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous source dates: %@ – %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前一期來源日期：%@ – %@"
          }
        }
      }
    },
    "activity.insights.insufficient %lld %lld %lld %lld" : {
      "extractionState": "manual",
      "comment": "Activity Insights: provider-reported daily buckets only; no billing, quota, or productivity meaning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison unavailable: current period %lld of %lld dates reported; previous period %lld of %lld. Both periods require every date to be reported."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法比較：本期已回報 %lld／%lld 個日期，前一期已回報 %lld／%lld 個日期。兩期都需完整回報每個日期。"
          }
        }
      }
    },
    "activity.insights.increased-percent %@" : {
